# ─────────────────────────────────────────────────────────────
# QSP WhatsApp AI Agent — environment configuration
# Copy this file to `.env` and fill in the values.
# ─────────────────────────────────────────────────────────────

# --- WATI (WhatsApp Business API) ---
# From your WATI dashboard → API Docs. The base URL looks like
# https://live-mt-server.wati.io/<tenant-id> (or your region's host).
WATI_BASE_URL=
WATI_AUTH_TOKEN=
# Optional, only for multi-channel / multi-tenant setups.
WATI_TENANT_ID=

# --- Anthropic (Claude LLM) ---
ANTHROPIC_API_KEY=
# Model used to generate replies. Default: claude-sonnet-4-6 (good quality at
# ~60% of Opus cost). Use claude-opus-4-8 for top quality, or claude-haiku-4-5
# for the lowest cost/latency on high volume.
ANTHROPIC_MODEL=claude-sonnet-4-6
# Max output tokens per reply (cap, not a target). Default: 4096.
ANTHROPIC_MAX_TOKENS=4096
# Thinking mode: "adaptive" (recommended) or "off" (faster, cheaper).
ANTHROPIC_THINKING=adaptive

# --- Webhook server ---
PORT=3000
WEBHOOK_PATH=/webhook
# Optional shared secret. If set, incoming webhooks must include it as
# ?token=... in the query string (configure the same value in the WATI URL).
WEBHOOK_VERIFY_TOKEN=

# --- Conversation ---
# How many past messages to pull from WATI for context. Default: 20.
HISTORY_PAGE_SIZE=20

# --- Webhook setup helper (scripts/setup-webhook.js) ---
# Your public base URL (e.g. an ngrok https URL). Used by `npm run setup:webhook`.
PUBLIC_URL=

# ── Shipday ────────────────────────────────────────────────────────────────
# Shipday Dashboard → Integrations → API → copiar la API key
SHIPDAY_API_KEY=

# ── Shopify ────────────────────────────────────────────────────────────────
# Solo necesario si usas el webhook propio en lugar de la app nativa de
# Shipday en Shopify. Shopify Admin → Settings → Notifications → Webhooks
# (el "signing secret" que muestra Shopify al crear el webhook).
SHOPIFY_WEBHOOK_SECRET=

# Token que agregas tú mismo a la URL del webhook de estados al registrarla
# en Shipday (Integraciones → API → Configuración de Webhook):
#   https://TU-SERVICIO/webhooks/shipday/status?token=<este valor>
SHIPDAY_WEBHOOK_TOKEN=

# ── WATI ───────────────────────────────────────────────────────────────────
# Token compartido que configuras tú mismo: el flujo de WATI debe enviarlo
# en el header "x-wati-token" al llamar a este servicio.
WATI_WEBHOOK_TOKEN=

# API de WATI (Dashboard → API Docs) — solo si quieres que este servicio
# reenvíe los estados de entrega de Shipday al cliente por WhatsApp.
# Déjalo apagado si usas las notificaciones WhatsApp nativas de Shipday
# (Branded Premium ya las incluye) para no duplicar mensajes.
WATI_NOTIFY=false
WATI_API_ENDPOINT=
WATI_API_TOKEN=

# ── Datos del negocio (punto de recogida por defecto) ──────────────────────
PICKUP_NAME=Quick Service Panama
PICKUP_ADDRESS=
PICKUP_PHONE=

# ── Tookan (solo para la migración de contactos) ───────────────────────────
# Tookan Dashboard → Settings → API Keys
TOOKAN_API_KEY=

# ── Servidor ───────────────────────────────────────────────────────────────
PORT=3000
